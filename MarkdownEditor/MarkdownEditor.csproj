<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MarkdownEditor</RootNamespace>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <Product>Markdown Editor</Product>
    <AssemblyTitle>Markdown Editor</AssemblyTitle>
    <Description>Visualizador e editor de arquivos Markdown, JSON, XML e texto</Description>
    <Company>Filipe Kanitz</Company>
    <Authors>Filipe Kanitz</Authors>
    <Copyright>Copyright © Filipe Kanitz</Copyright>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\Markdown.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Necessário para o código gerado pelo LibraryImport (NativeMethods.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- WinUI 3 (Windows App SDK), sem pacote MSIX: distribuído pelo instalador Inno Setup.
         O Windows App SDK vai junto do programa (self-contained); o .NET continua sendo exigido na máquina. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Gera e publica o MarkdownEditor.pri (com o XAML compilado); sem ele o exe publicado fecha ao abrir. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- O Windows App SDK self-contained exige um RuntimeIdentifier: x64 por padrão (build, F5 e Release.cmd). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Markdown.ico" Link="Assets\Markdown.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Arquivos parciais da JanelaPrincipal: agrupados sob o code-behind do XAML -->
  <ItemGroup>
    <Compile Update="JanelaPrincipal.Arvore.cs;JanelaPrincipal.Dialogos.cs;JanelaPrincipal.Editor.cs;JanelaPrincipal.Historico.cs;JanelaPrincipal.Monitor.cs;JanelaPrincipal.Preview.cs;JanelaPrincipal.Sobre.cs;JanelaPrincipal.Tema.cs">
      <DependentUpon>JanelaPrincipal.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
