<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MarkdownEditor.JanelaPrincipal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarkdownEditor"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="grdRaiz">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="tlbTitulo"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="tlbTitulo_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Markdown.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <CommandBar
            x:Name="cbrComandos"
            Grid.Row="1"
            Margin="4,0,4,4"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="False"
            OverflowButtonVisibility="Collapsed">
            <AppBarButton
                x:Name="abbVoltar"
                Icon="Back"
                IsEnabled="False"
                KeyboardAcceleratorPlacementMode="Hidden"
                Click="abbVoltar_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="abbAvancar"
                Icon="Forward"
                IsEnabled="False"
                KeyboardAcceleratorPlacementMode="Hidden"
                Click="abbAvancar_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarElementContainer VerticalContentAlignment="Center">
                <toolkit:Segmented x:Name="sgmModo" Margin="4,0" SelectedIndex="0" SelectionChanged="sgmModo_SelectionChanged">
                    <toolkit:SegmentedItem x:Name="sgiVisualizar">
                        <toolkit:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE890;" />
                        </toolkit:SegmentedItem.Icon>
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem x:Name="sgiEditar">
                        <toolkit:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </toolkit:SegmentedItem.Icon>
                    </toolkit:SegmentedItem>
                </toolkit:Segmented>
            </AppBarElementContainer>
            <AppBarSeparator x:Name="absSalvar" Visibility="Collapsed" />
            <AppBarButton
                x:Name="abbSalvar"
                Icon="Save"
                IsEnabled="False"
                Visibility="Collapsed"
                KeyboardAcceleratorPlacementMode="Hidden"
                Click="abbSalvar_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="abbDesfazer"
                Icon="Undo"
                IsEnabled="False"
                Visibility="Collapsed"
                Click="abbDesfazer_Click" />
            <AppBarSeparator />
            <AppBarButton x:Name="abbIdioma">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE774;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <!-- Tag = código do idioma; vazio = idioma do Windows. Os nomes ficam sempre no próprio idioma. -->
                    <MenuFlyout x:Name="mfoIdioma" Placement="Bottom">
                        <RadioMenuFlyoutItem x:Name="rmiIdiomaWindows" GroupName="Idioma" Tag="" Click="rmiIdioma_Click" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem x:Name="rmiPortugues" GroupName="Idioma" Tag="pt-BR" Text="Português (Brasil)" Click="rmiIdioma_Click" />
                        <RadioMenuFlyoutItem x:Name="rmiIngles" GroupName="Idioma" Tag="en-US" Text="English" Click="rmiIdioma_Click" />
                        <RadioMenuFlyoutItem x:Name="rmiEspanhol" GroupName="Idioma" Tag="es-ES" Text="Español" Click="rmiIdioma_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                x:Name="abbSobre"
                KeyboardAcceleratorPlacementMode="Hidden"
                Click="abbSobre_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F1" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <Grid x:Name="grdCorpo" Grid.Row="2" Padding="0,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colArvore" Width="280" MinWidth="50" />
                <ColumnDefinition x:Name="colDivisoria" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <TreeView
                x:Name="trvPastas"
                Grid.Column="0"
                SelectionMode="Single"
                CanDragItems="False"
                CanReorderItems="False"
                AllowDrop="False"
                Expanding="trvPastas_Expanding"
                SelectionChanged="trvPastas_SelectionChanged"
                ContextRequested="trvPastas_ContextRequested">
                <TreeView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.22" />
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.30" />
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedDisabled" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.28" />
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.36" />
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.20" />
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedDisabled" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.14" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TreeView.Resources>
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="TreeViewNode">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Width="16" Height="16" Source="{x:Bind ((local:ItemArvore)Content).Icone, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ((local:ItemArvore)Content).Nome, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <toolkit:GridSplitter
                x:Name="gspDivisoria"
                Grid.Column="1"
                Width="8"
                MinWidth="8"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />

            <Grid
                x:Name="grdConteudo"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <WebView2 x:Name="wvwPreview" />
                <WebView2 x:Name="wvwEditor" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
